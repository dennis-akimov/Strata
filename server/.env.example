# server/.env: the chat container's settings (make up reads it too).
# The Strata folder (run configs, logs) and the models' folder: mounted at these same paths in the container.
STRATA_DIR=/Users/you/Strata
STRATA_DATA=/Users/you/Strata-data
# the run config the container serves (its "exe" is the host's engine; the container reaches it through the relay)
STRATA_CONFIG=/Users/you/Strata/strata-gpt-oss-120b-heretic.json
# the chat page and API on the host: http://127.0.0.1:CHAT_PORT/
CHAT_PORT=8091
# strata-relay on the host (make relay); the token is shared by the relay and the container (openssl rand -hex 24)
RELAY_PORT=7071
STRATA_RELAY_TOKEN=change-me-to-a-long-random-token
