     // Memory
     //
--- a/src/llama-adapter.h
+++ b/src/llama-adapter.h
@@ -27,9 +27,24 @@
             int32_t il_start,
             int32_t il_end);
 
+    // Strata: directions projected out of a layer's output (llama_set_adapter_ablation)
+    bool apply_ablation(
+            const llama_model & model,
+            const float * data,
+            size_t len,
+            int32_t n_embd,
+            int32_t k,
+            float scale);
+
 private:
     bool init(const llama_model & model);
 
+    std::vector<ggml_tensor *> abl;    // per layer: [n_embd, k], or nullptr
+    std::vector<ggml_tensor *> abl_t;  // per layer: [k, n_embd], the same rows transposed
+    float abl_scale = 1.0f;
+    std::vector<ggml_context_ptr> abl_ctxs;
+    std::vector<ggml_backend_buffer_ptr> abl_bufs;
+
     int32_t layer_start = -1;
     int32_t layer_end   = -1;
 
--- a/src/llama-adapter.cpp
+++ b/src/llama-adapter.cpp
@@ -27,7 +27,103 @@
         cur = ggml_add(ctx, cur, layer_dir);
     }
 
+    // Strata: remove the layer's directions from every row (every hyper-connection stream of every token)
+    if (il >= 0 && (size_t) il < abl.size() && abl[il] != nullptr) {
+        ggml_tensor * x = ggml_is_contiguous(cur) ? cur : ggml_cont(ctx, cur);
+        ggml_tensor * rows = ggml_reshape_2d(ctx, x, x->ne[0], ggml_nelements(x) / x->ne[0]);
+        ggml_tensor * coef = ggml_mul_mat(ctx, abl[il], rows);    // [k, rows]: (row . v_k)
+        ggml_tensor * back = ggml_mul_mat(ctx, abl_t[il], coef);  // [n_embd, rows]: sum_k (row . v_k) v_k
+        if (abl_scale != 1.0f) {
+            back = ggml_scale(ctx, back, abl_scale);
+        }
+        cur = ggml_reshape(ctx, ggml_sub(ctx, rows, back), x);
+    }
+
     return cur;
+}
+
+bool llama_adapter_cvec::apply_ablation(
+        const llama_model & model,
+        const float * data,
+        size_t len,
+        int32_t n_embd,
+        int32_t k,
+        float scale) {
+    const auto & hparams = model.hparams;
+    const int64_t n_layer = hparams.n_layer();
+
+    abl.clear();
+    abl_t.clear();
+    abl_bufs.clear();
+    abl_ctxs.clear();
+    if (data == nullptr) {
+        return true;
+    }
+    if (n_embd != (int) hparams.n_embd || k <= 0 || len % ((size_t) k * n_embd) != 0 ||
+            len / ((size_t) k * n_embd) > (size_t) n_layer) {
+        LLAMA_LOG_ERROR("%s: %zu floats are not up to %lld layers of %d x %d (n_embd %u)\n", __func__, len,
+                        (long long) n_layer, k, n_embd, hparams.n_embd);
+        return false;
+    }
+    abl_scale = scale;
+    const int64_t n_given = (int64_t) (len / ((size_t) k * n_embd));
+    const size_t per = (size_t) k * n_embd;
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    abl.assign(n_given, nullptr);
+    abl_t.assign(n_given, nullptr);
+    for (int64_t il = 0; il < n_given; il++) {
+        const float * v = data + il * per;
+        bool any = false;
+        for (size_t i = 0; i < per && !any; i++) {
+            any = v[i] != 0.0f;
+        }
+        if (!any) {
+            continue;                                    // a layer of zeros is left alone
+        }
+        ggml_backend_buffer_type_t buft = model.select_buft(il);
+        auto it = ctx_map.find(buft);
+        if (it == ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ (size_t) 2 * n_layer * ggml_tensor_overhead(),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context * c = ggml_init(params);
+            if (!c) {
+                return false;
+            }
+            abl_ctxs.emplace_back(c);
+            it = ctx_map.emplace(buft, c).first;
+        }
+        abl[il]   = ggml_new_tensor_2d(it->second, GGML_TYPE_F32, n_embd, k);
+        abl_t[il] = ggml_new_tensor_2d(it->second, GGML_TYPE_F32, k, n_embd);
+    }
+    for (auto & [buft, c] : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(c, buft);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate the ablation directions\n", __func__);
+            abl.clear();
+            abl_t.clear();
+            return false;
+        }
+        abl_bufs.emplace_back(buf);
+    }
+    std::vector<float> t(per);
+    for (int64_t il = 0; il < n_given; il++) {
+        if (abl[il] == nullptr) {
+            continue;
+        }
+        const float * v = data + il * per;
+        ggml_backend_tensor_set(abl[il], v, 0, per * sizeof(float));
+        for (int32_t r = 0; r < k; r++) {               // transposed: element (r, i) at i * k + r
+            for (int32_t i = 0; i < n_embd; i++) {
+                t[(size_t) i * k + r] = v[(size_t) r * n_embd + i];
+            }
+        }
+        ggml_backend_tensor_set(abl_t[il], t.data(), 0, per * sizeof(float));
+    }
+    return true;
 }
 
