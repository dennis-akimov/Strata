+++ b/include/llama.h
@@ -746,6 +746,17 @@
                          int32_t   il_start,
                          int32_t   il_end);
 
+    // Strata: project directions out of each layer's output, where a control vector is added (directional ablation):
+    // out = out - scale * sum_k (out . v_k) v_k.  data holds n_layers x k x n_embd floats from layer 0, each layer's
+    // k rows orthonormal; a layer of zeros is left alone.  len = the number of floats.  data == NULL turns it off.
+    LLAMA_API int32_t llama_set_adapter_ablation(
+            struct llama_context * ctx,
+                     const float * data,
+                          size_t   len,
+                         int32_t   n_embd,
+                         int32_t   k,
+                           float   scale);
+
